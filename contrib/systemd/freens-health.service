# freens chair monitoring: a systemd timer running `freens doctor` on a
# schedule. Failures land in the journal with the unit's name — pair with
# any log-alerting you already run (journalctl -u freens-health, or your
# host's email/pager bridge on OnFailure=).
#
# Install (as root):
#   install -m644 freens-health.service freens-health.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now freens-health.timer
#
# The service runs as the SAME USER that ran `freens setup` (the one owning
# the freens state dir and the daemon's admin socket). Replace YOURUSER if
# needed. State-dir location matters: doctor reads $FREENS_HOME (default
# ~/.freens). Default installs need no Environment line; installs migrated
# to the XDG layout (~/.local/share/freens) MUST set it — a systemd SYSTEM
# unit cannot use %h for this (%h expands to /root regardless of User=),
# so hardcode the absolute path as shown.

[Unit]
Description=freens health check (doctor)

[Service]
Type=oneshot
User=YOURUSER
#Environment=FREENS_HOME=/home/YOURUSER/.local/share/freens
ExecStart=/usr/local/bin/freens doctor
# doctor exits non-zero when any check fails — OnFailure fires the alert
# path below. Uncomment and point at your notifier (mail, ntfy, pager):
#OnFailure=notify-email@.service
